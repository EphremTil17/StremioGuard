[Unit]
Description=Guard Stremio behind the gluetun VPN container
After=docker.service

[Service]
# Adjust these paths if StremioGuard is not cloned to ~/StremioGuard.
Type=forking
WorkingDirectory=%h/StremioGuard
ExecStart=%h/StremioGuard/stremio start
ExecStop=%h/StremioGuard/stremio stop
PIDFile=%h/StremioGuard/.stremio/watchdog.pid
Restart=always
RestartSec=10
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
