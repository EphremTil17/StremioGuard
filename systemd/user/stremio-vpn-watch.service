[Unit]
Description=Guard Stremio behind the gluetun VPN container
After=docker.service

[Service]
Type=forking
WorkingDirectory=%h/projects/docker/StremioGuard
ExecStart=%h/projects/docker/StremioGuard/stremio start
ExecStop=%h/projects/docker/StremioGuard/stremio stop
PIDFile=%h/projects/docker/StremioGuard/.stremio/watchdog.pid
Restart=always
RestartSec=10
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
