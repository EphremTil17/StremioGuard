# StremioGuard reads this file with a simple line parser, not a full dotenv
# implementation. For each KEY=VALUE line, everything after the first '=' is the
# value, taken verbatim. Do NOT quote values, add inline '# comments' after a
# value, or use 'export'. Full-line comments (like this one) are fine.

VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard

# --- NordVPN WireGuard ---
# Recommended for speed and stability.
# Obtain your permanent WireGuard private key via your NordVPN Access Token:
#   1. Generate a token at https://my.nordaccount.com/dashboard/nordvpn/access-tokens/
#   2. Run `./stremio init` to fetch it automatically, or retrieve it manually:
#      curl -s -u token:<ACCESS_TOKEN> https://api.nordvpn.com/v1/users/services/credentials
WIREGUARD_PRIVATE_KEY=<paste-key-here>
WIREGUARD_ADDRESSES=10.5.0.2/32
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s

# --- NordVPN OpenVPN ---
# Alternative path if you prefer service credentials over WireGuard.
OPENVPN_USER=<paste-service-username-here>
OPENVPN_PASSWORD=<paste-service-password-here>

SERVER_COUNTRIES=United States
# SERVER_CITIES=Seattle
# SERVER_HOSTNAMES=us1234.nordvpn.com

FIREWALL=on
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

TZ=America/Chicago

# --- Optional Stremio server tweaks ---
# Set to 0 to disable the Stremio Streaming Server container in this stack
# (e.g. for a Comet-Only headless deployment).
STREMIO_ENABLED=1

# Keep our compatibility patch bundle enabled unless you deliberately want the
# upstream image behavior back. Turning this off removes the HTTPS redirect fix,
# the local self-probe rewrite, the favicon guard, and the /casting stub.
STREMIO_APPLY_PATCHES=1
#
# CASTING_DISABLED=1 silences SSDP "EPERM 239.255.255.250:1900" log noise from
# gluetun's firewall correctly dropping outbound multicast. Our local image
# keeps a stub /casting endpoint alive in that mode so the Stremio web client
# sees an empty device list instead of a false "streaming server might be
# offline" warning.
CASTING_DISABLED=1

# --- Optional log-noise reduction ---
# Skip repeated /device-info hardware-acceleration probe runs. This does not
# change playback behavior; it only prevents the server from re-testing qsv,
# nvenc, and vaapi on every reconnect when no profile is configured.
STREMIO_SKIP_HW_PROBE=1

# Host port and bind addresses for the Stremio streaming server. Use a
# comma-separated bind list for LAN + Tailscale without exposing every interface:
#   <LAN-IP>    e.g. 192.168.1.100 — find with `ip -4 addr show` or `hostname -I`
#   <TAILSCALE-IP> e.g. 100.x.y.z — find with `tailscale ip -4`
#   0.0.0.0     binds on every NIC; only needed on multi-homed hosts
#   127.0.0.1   loopback; makes Stremio unreachable from LAN/Tailscale and is
#               present here only as a fail-safe default for unconfigured runs
# `./stremio init` walks you through this.
STREMIO_HOST_PORT=11470
STREMIO_BIND_ADDRS=127.0.0.1

# Public origin clients use to reach Stremio. Set in Tier 2/3 (reverse-proxied
# behind a domain) to e.g. https://stremio.example.com. Leave blank in Tier 1
# (LAN + Tailscale only) — Stremio will use whatever host:port the client
# actually connected to, such as http://<host-LAN-IP>:11470.
EXTERNAL_BASE_URL=

# --- Optional Comet playback-proxy subsystem ---
# Managed via `./stremio comet ...`. These values live in the root .env because
# they describe how StremioGuard should provision and expose the upstream Comet
# stack; the generated runtime env for Comet itself lives under .stremio/comet/.
# Comet inherits `STREMIO_BIND_ADDRS` in the unified stack model so both
# services publish on the same host interfaces.
COMET_ENABLED=1
# COMET_IMAGE must be a repository name (e.g. g0ldyy/comet) without a tag or digest.
# StremioGuard pins and resolves the exact image digest in its local state.
COMET_IMAGE=g0ldyy/comet
COMET_HOST_PORT=18000
COMET_PUBLIC_BASE_URL=
COMET_CONFIGURE_PAGE_PASSWORD=
COMET_PROXY_DEBRID_STREAM=1
COMET_PROXY_MAX_CONNECTIONS=-1
COMET_HEALTHCHECK_INTERVAL_SECONDS=300
COMET_RESULT_FORMAT_STYLE=plain
COMET_PATCH_EPISODE_PACK_RESULTS=1
COMET_SCRAPE_TORRENTIO=live
COMET_TORRENTIO_URL=https://torrentio.strem.fun
COMET_SCRAPE_ZILEAN=live
COMET_ZILEAN_URL=https://zileanfortheweebs.midnightignite.me
# Optional server-owned fallback debrid credentials. Leave blank if you plan to
# configure the final addon entirely in Comet's `/configure` page and then
# distribute only the finished addon/account to users.
COMET_DEFAULT_DEBRID_SERVICE=realdebrid
COMET_DEFAULT_DEBRID_APIKEY=

# --- Optional token-managed Comet gateway ---
# The gateway protects addon install/query/playback routes with a URL token:
#   https://comet.example.com/comet/<token>/<config>/manifest.json
# Keep raw Comet on localhost for diagnostics; point public reverse proxies at
# COMET_GATEWAY_HOST_PORT instead.
COMET_GATEWAY_ENABLED=1
COMET_GATEWAY_HOST_PORT=18001
# Example: https://comet.example.com. Leave blank for local host/port inference.
COMET_GATEWAY_PUBLIC_BASE_URL=
COMET_GATEWAY_TOKEN_LENGTH=8

# Private loopback origin the server should use for ffprobe and HLS self-
# references instead of going back out through the public reverse proxy.
INTERNAL_MEDIA_BASE_URL=http://127.0.0.1:11470

# Watchdog poll cadence stays tight for safety; summary log cadence stays slower
# to avoid flooding logs during healthy steady-state runs.
# WATCH_INTERVAL_SECONDS=10
# WATCHDOG_LOG_INTERVAL_SECONDS=300
# PUBLIC_IP_FAILURE_THRESHOLD=3
# IP_CROSSCHECK_INTERVAL_SECONDS=300
# VPN_RECOVERY_BUDGET_SECONDS=300
# VPN_RESTART_CADENCE_SECONDS=45
# UPDATER_PERIOD=480h

# --- Future providers (uncomment to switch) ---
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.64.x.x/32
# SERVER_CITIES=New York
