#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

INSTALL_MISSING_DEPS="${INSTALL_MISSING_DEPS:-1}"
UV_INSTALL_DIR="${UV_INSTALL_DIR:-$HOME/.local/bin}"

ensure_uv() {
    if command -v uv >/dev/null 2>&1; then
        return 0
    fi

    case ":${PATH}:" in
        *":${UV_INSTALL_DIR}:"*) ;;
        *) export PATH="${UV_INSTALL_DIR}:${PATH}" ;;
    esac
    if command -v uv >/dev/null 2>&1; then
        return 0
    fi

    if [[ "${INSTALL_MISSING_DEPS}" != "1" ]]; then
        echo "uv is required but not installed and INSTALL_MISSING_DEPS=0." >&2
        echo "Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
        return 1
    fi

    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to bootstrap uv but is not installed." >&2
        echo "Install curl, or install uv manually: https://docs.astral.sh/uv/" >&2
        return 1
    fi

    echo "uv is missing; installing via the official installer to ${UV_INSTALL_DIR}." >&2
    if ! curl -LsSf https://astral.sh/uv/install.sh | sh; then
        echo "uv installation failed." >&2
        echo "Install it manually: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
        return 1
    fi

    case ":${PATH}:" in
        *":${UV_INSTALL_DIR}:"*) ;;
        *) export PATH="${UV_INSTALL_DIR}:${PATH}" ;;
    esac

    if ! command -v uv >/dev/null 2>&1; then
        echo "uv installed but is not on PATH (looked in ${UV_INSTALL_DIR})." >&2
        echo "Add it to PATH and rerun, or pass UV_INSTALL_DIR=/path/to/bin." >&2
        return 1
    fi
}

ensure_uv

# Whoever runs this gets their own virtualenv and cache unless they own the
# checkout. Syncing dependencies as a different user (sudo, a service
# account) would otherwise leave files in ./.venv and ./.uv-cache that the
# repo owner cannot write, silently breaking their `uv run` later. The test
# is ownership rather than "am I root", so a non-root service account is
# covered too.
repo_uid="$(stat -c %u "$ROOT_DIR" 2>/dev/null || echo -1)"
if [[ "$(id -u)" != "${repo_uid}" ]]; then
    state_dir="${STREMIOGUARD_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/stremioguard}"
    UV_CACHE_DIR="${UV_CACHE_DIR:-${state_dir}/uv-cache}"
    UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-${state_dir}/venv}"
    mkdir -p "${UV_CACHE_DIR}" "$(dirname -- "${UV_PROJECT_ENVIRONMENT}")"
    chmod 700 "${state_dir}"
else
    UV_CACHE_DIR="${UV_CACHE_DIR:-$ROOT_DIR/.uv-cache}"
    UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$ROOT_DIR/.venv}"
fi
export UV_CACHE_DIR UV_PROJECT_ENVIRONMENT

exec uv run python -m stremioguard.cli "$@"
